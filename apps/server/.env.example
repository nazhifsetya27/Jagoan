# Notion Configuration
NOTION_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here
NOTION_LIVING_COST_PAGE_ID=your_living_cost_page_id_here
NOTION_BUDGET_RELATION_NAME=your_budget_relation_name_here

# Optional: name of a Date property to stamp with today's date. Leave UNSET if your
# Daily Transactions DB uses a created_time property (e.g. "created_at") — Notion fills
# that automatically and the API rejects writes to a Date property that doesn't exist.
# NOTION_DATE_PROPERTY_NAME=Date

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
MY_CHAT_ID=your_telegram_chat_id

# Server Configuration
PORT=3000

# Confirmation Mode
# "telegram" (default): prompt for the transaction purpose via the Telegram bot.
# "overlay": the Android app shows a floating overlay to capture purpose + category.
MODE=telegram

# Overlay category source (priority order):
#
# 0. By DEFAULT (recommended) you set NOTHING here — the server derives your Budgeting
#    database automatically from the NOTION_BUDGET_RELATION_NAME relation on your
#    Daily Transactions DB (NOTION_DATABASE_ID). Each row becomes a selectable category,
#    cached 5 minutes. Next month you only change NOTION_DATABASE_ID.
#
# 1. NOTION_BUDGET_DATABASE_ID — optional override to pin categories to a specific
#    Budgeting database instead of the derived one.
# NOTION_BUDGET_DATABASE_ID=your_budgeting_database_id
#
# 2. NOTION_CATEGORIES — optional static list (used only when NOTION_BUDGET_DATABASE_ID
#    is unset). JSON array of {key,label,pageId}; sent to the overlay as {key,label} only.
# NOTION_CATEGORIES=[{"key":"living_cost","label":"Living Cost","pageId":"your_living_cost_page_id"},{"key":"transport","label":"Transport","pageId":"your_transport_page_id"}]
#
# 3. If none of the above resolve, falls back to a single "living_cost" category using
#    NOTION_LIVING_COST_PAGE_ID above.
